# Локальный кеш Terraform (НЕ включать в репозиторий)
.terraform/

# Файлы состояний (никогда не хранить в Git!)
*.tfstate
*.tfstate.*

# Логи и crash-файлы
crash.log
crash.*.log

# Файлы с переменными, которые могут содержать секреты
*.tfvars
*.tfvars.json
secret.yaml

# Переопределения провайдеров (обычно для разработки)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI конфигурация (может содержать credentials)
.terraformrc
terraform.rc

# Резервные файлы
*.backup
*.bak
*~

# Результаты команд
terraform.tfplan
plan.out
